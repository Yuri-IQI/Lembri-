{
  "expo": {
    "name": "MobileAPP",
    "slug": "MobileAPP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7EC",
    "android": {
      "package": "com.borabill.lembriwearable",
      "adaptiveIcon": {
        "backgroundColor": "#E8E08A",
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "monochromeImage": "./assets/icon/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7EC",
          "image": "./assets/splash/splash-native.png",
          "imageWidth": 240
        }
      ],
      "./plugins/with-shared-debug-keystore",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "EBGaramond",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/eb-garamond/500Medium/EBGaramond_500Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      "./plugins/with-fast-gradle",
      "./plugins/with-windows-cmake",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Lembri usa o microfone para entender seus comandos de voz.",
          "speechRecognitionPermission": "O Lembri usa o reconhecimento de fala para entender seus comandos de voz.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
